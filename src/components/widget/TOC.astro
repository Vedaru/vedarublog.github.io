---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";

interface Props {
	class?: string;
	headings: MarkdownHeading[];
}

let { headings = [] } = Astro.props;
const className = Astro.props.class;

let minDepth = 10;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}

// 与 Fuwari 一致：只保留从最小层级起 depth 层标题。
const visibleHeadings = headings.filter(
	(heading) => heading.depth < minDepth + siteConfig.toc.depth,
);

const removeTailingHash = (text: string) => {
	const lastIndexOfHash = text.lastIndexOf("#");
	if (lastIndexOfHash !== text.length - 1) return text;
	return text.substring(0, lastIndexOfHash);
};

// 一级标题徽章：默认数字，配置开启后使用片假名。
const KATAKANA = [
	"ア", "イ", "ウ", "エ", "オ", "カ", "キ", "ク", "ケ", "コ",
	"サ", "シ", "ス", "セ", "ソ", "タ", "チ", "ツ", "テ", "ト",
	"ナ", "ニ", "ヌ", "ネ", "ノ", "ハ", "ヒ", "フ", "ヘ", "ホ",
	"マ", "ミ", "ム", "メ", "モ", "ヤ", "ユ", "ヨ", "ラ", "リ",
	"ル", "レ", "ロ", "ワ", "ヲ", "ン",
] as const;

let heading1Count = 0;
const badgeFor = (index: number, depth: number) => {
	if (depth !== minDepth) return "";
	const text = siteConfig.toc.useJapaneseBadge
		? (KATAKANA[index] ?? String(index + 1))
		: String(index + 1);
	heading1Count++;
	return text;
};
---

<table-of-contents class:list={[className, "group"]}>
	{
		visibleHeadings.map((heading) => {
			const depthClass =
				heading.depth === minDepth
					? ""
					: heading.depth === minDepth + 1
						? "ml-4"
						: "ml-8";
			const badge = badgeFor(heading1Count, heading.depth);

			return (
				<a
					href={`#${heading.slug}`}
					class="px-2 flex gap-2 relative transition w-full min-h-9 rounded-xl hover:bg-[var(--toc-btn-hover)] active:bg-[var(--toc-btn-active)] py-2"
				>
					<div
						class:list={[
							"transition w-5 h-5 shrink-0 rounded-lg text-xs flex items-center justify-center font-bold",
							depthClass,
							{
								"bg-[var(--toc-badge-bg)] text-[var(--btn-content)]":
									heading.depth === minDepth,
							},
						]}
					>
						{heading.depth === minDepth && badge}
						{heading.depth === minDepth + 1 && (
							<div class="transition w-2 h-2 rounded-[0.1875rem] bg-[var(--toc-badge-bg)]" />
						)}
						{heading.depth === minDepth + 2 && (
							<div class="transition w-1.5 h-1.5 rounded-sm bg-black/5 dark:bg-white/10" />
						)}
					</div>
					<div
						class:list={[
							"transition text-sm",
							{
								"text-50":
									heading.depth === minDepth ||
									heading.depth === minDepth + 1,
								"text-30": heading.depth === minDepth + 2,
							},
						]}
					>
						{removeTailingHash(heading.text)}
					</div>
				</a>
			);
		})
	}
	<div
		id="active-indicator"
		style="opacity: 0"
		class:list={[
			"hidden",
			"-z-10 absolute bg-[var(--toc-btn-hover)] left-0 right-0 rounded-xl transition-[top,height,opacity,background-color,border-color] group-hover:bg-transparent border-2 border-[var(--toc-btn-hover)] group-hover:border-[var(--toc-btn-active)] border-dashed",
		]}
	>
	</div>
</table-of-contents>

<style>
	table-of-contents {
		display: block;
		position: relative;
	}

	table-of-contents a.visible > div:last-child {
		color: var(--toc-active-text);
	}

	table-of-contents a.visible > div:first-child.bg-\[var\(--toc-badge-bg\)\] {
		/* --btn-content is the same hue family as --primary and disappears on
		   the active badge. Use the deep text colour for contrast. */
		@apply bg-[var(--primary)] text-[var(--deep-text)];
	}
</style>
