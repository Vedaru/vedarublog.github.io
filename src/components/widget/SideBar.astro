---
import type { MarkdownHeading } from "astro";
import { widgetManager } from "../../utils/widget-manager";
import Announcement from "./Announcement.astro";
import Calendar from "./Calendar.astro";
import Categories from "./Categories.astro";
import MusicPlayer from "./MusicPlayer.svelte";
import Profile from "./Profile.astro";
import SiteStats from "./SiteStats.astro";
import Tags from "./Tags.astro";
import TOC from "./TOC.astro";

interface Props {
	class?: string;
	side?: "left" | "right";
	headings?: MarkdownHeading[];
}

const { class: className, side = "left", headings = [] } = Astro.props;
const topComponents = widgetManager.getComponentsByPosition("top", side);
const displayTopComponents =
	topComponents.length > 0
		? topComponents
		: side === "left"
			? [{ type: "profile", position: "top" }]
			: [];
const stickyComponents = widgetManager.getComponentsByPosition("sticky", side);

const componentMap = {
	profile: Profile,
	announcement: Announcement,
	categories: Categories,
	tags: Tags,
	toc: TOC,
	"music-player": MusicPlayer,
	"site-stats": SiteStats,
	calendar: Calendar,
};

function renderComponent(component: any, index: number) {
	const ComponentToRender = componentMap[component.type as keyof typeof componentMap];
	if (!ComponentToRender) return null;

	return {
		Component: ComponentToRender,
		props: {
			class: widgetManager.getComponentClass(component, index),
			style: widgetManager.getComponentStyle(component, index),
			headings: component.type === "toc" ? headings : undefined,
			...component.customProps,
		},
	};
}
---

<div id={side === "right" ? "right-sidebar" : "sidebar"} class:list={[className, "w-full"]}>
	<div class="onload-animation flex flex-col w-full gap-4 mb-4">
		{displayTopComponents.map((component, index) => {
				const renderData = renderComponent(component, index);
				if (!renderData) return null;
				const { Component, props } = renderData;
				return <Component {...props} />;
			})}
	</div>
	<div
		id={side === "right" ? "right-sidebar-sticky" : "sidebar-sticky"}
		class="onload-animation transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4"
	>
		{stickyComponents.map((component, index) => {
			const renderData = renderComponent(component, index);
			if (!renderData) return null;
			const { Component, props } = renderData;
			return <Component {...props} />;
		})}
	</div>
</div>
