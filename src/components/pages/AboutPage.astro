---

import { getCollection, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// spec 集合的 id 含扩展名（about.md / about.en.md），因此直接按 id 查找；
// 英文版缺失时回退到中文版，避免页面直接报错。
const specEntries = await getCollection("spec");
const byId = (id: string) => specEntries.find((entry) => entry.id === id);
const aboutPost =
	(Astro.currentLocale === "en" ? byId("about.en.md") : undefined) ??
	byId("about.md");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
const title = i18n(I18nKey.about, Astro.currentLocale);
---
<MainGridLayout title={title} dualLocale>
	<!-- 引入右侧边栏布局管理器 -->
  <script>
    import('@/scripts/right-sidebar-layout.js');
  </script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <!-- 页面标题 -->
            <div class="flex flex-col items-start justify-center mb-8">
                <h1 class="text-4xl font-bold text-black/90 dark:text-white/90 mb-2 relative
                          before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                          before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4">
                    {title}
                </h1>
            </div>
            
            
            <!-- 从MD文件读取的内容 -->
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
