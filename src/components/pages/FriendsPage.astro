---
import { getCollection, render } from "astro:content";
import FriendsPanel from "@components/features/friends/FriendsPanel.svelte";
import Markdown from "@components/misc/Markdown.astro";
import { siteConfig } from "@/config";
import { getShuffledFriendsList } from "@/data/friends";
import { localizedText, normalizeLocale } from "@/i18n/translation";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 检查友链页面是否启用
if (!siteConfig.featurePages.friends) {
	return Astro.redirect("/404/");
}

// 同 AboutPage：spec 的 id 含扩展名，按 id 查找并回退到中文版。
const specEntries = await getCollection("spec");
const byId = (id: string) => specEntries.find((entry) => entry.id === id);
const friendsPost =
	(Astro.currentLocale === "en" ? byId("friends.en.md") : undefined) ??
	byId("friends.zh.md");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);
// 简介是中英双份（desc / descEn），在这里挑好语言再交给岛屿，
// 这样岛屿内的搜索也只搜当前语言的内容。
const locale = normalizeLocale(Astro.currentLocale);
const friendsList = getShuffledFriendsList().map((item) => ({
	...item,
	desc: localizedText(locale, item.desc, item.descEn),
}));
---

<MainGridLayout title={i18n(I18nKey.friends, Astro.currentLocale)} description={i18n(I18nKey.friends, Astro.currentLocale)} dualLocale>
  <script>
    import('@/scripts/right-sidebar-layout.js');
  </script>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div data-search-body class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="flex flex-col items-start justify-center mb-8">
        <h1 class="text-4xl font-bold text-black/90 dark:text-white/90 mb-2 relative
                  before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                  before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4">
          {i18n(I18nKey.friends, Astro.currentLocale)}
        </h1>
        <p class="text-lg text-black/60 dark:text-white/60">
          {i18n(I18nKey.friendsSubtitle, Astro.currentLocale)}
        </p>
			</div>

			<!-- 搜索、标签筛选与友链卡片，均在客户端组件内完成过滤 -->
			<FriendsPanel friendsList={friendsList} locale={Astro.currentLocale} client:load />

			<!-- 说明文档 -->
			<Markdown class="mt-8 prose dark:prose-invert max-w-none">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
