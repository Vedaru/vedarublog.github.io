---
import ArchivePanel from "@components/features/archive/ArchivePanel.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n, normalizeLocale } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {
	filterArchivePosts,
	type ArchiveFilterKind,
} from "@utils/archive-utils";
import { getSortedPostsList } from "@utils/content-utils";

interface Props {
	kind?: ArchiveFilterKind;
	value?: string;
}

const { kind, value } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);

const sortedPostsList = await getSortedPostsList(
	locale,
);
const filteredPosts = kind
	? filterArchivePosts(sortedPostsList, kind, value)
	: sortedPostsList;

// 1. 修复类型兼容性：将 category 的 null 转换为 undefined
const posts = filteredPosts.map((post) => ({
	id: post.id,
	url: post.url,
	data: {
		title: post.data.title,
		tags: post.data.tags,
		category: post.data.category === null ? undefined : post.data.category,
		published: post.data.published,
	},
}));

const title = kind
	? `${i18n(I18nKey.archive, Astro.currentLocale)} · ${
			kind === "uncategorized"
				? i18n(I18nKey.uncategorized, Astro.currentLocale)
				: value
		}`
	: i18n(I18nKey.archive, Astro.currentLocale);
---

<MainGridLayout title={title} dualLocale>
	<ArchivePanel sortedPosts={posts} locale={Astro.currentLocale} />
</MainGridLayout>
