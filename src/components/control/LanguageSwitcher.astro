---
/**
 * 语言选择器 / Language selector.
 *
 * 与导航栏其它控件（壁纸、明暗、布局）同样的形态：一个图标按钮 +
 * float-panel 下拉面板，列出所有已启用语言，当前语言打勾。
 *
 * 两处刻意的设计：
 *
 * 1. 不用 Svelte 岛。切换器没有任何响应式状态，面板开合由共用的
 *    panelManager 负责，URL 也是纯字符串运算，所以用普通按钮 + 一段
 *    内联脚本即可，省掉一个岛和它的加载。
 *
 * 2. 目标地址在**点击时**才解析。导航栏在 swup 容器之外，换页时不会
 *    重建，构建期写死的 href 会在客户端换页后过期（读了文章再切语言
 *    会跳回旧页面对应的地址）。href 仍然按换前缀渲染，保证无 JS 时也
 *    能用；有 JS 时由脚本按 location.pathname 重新算一次。
 *
 * 选项链接带 data-no-swup：swup 只替换 <main>，走客户端换页的话导航栏、
 * 侧栏和 <html lang> 都还停在旧语言，看起来就像“语言根本没切”。
 */
import { Icon } from "astro-icon/components";
import { i18nConfig } from "../../config";
import { getLocaleCoverage } from "@i18n/coverage";
import { resolveAlternatePath } from "@i18n/locale-paths";
import { getLocaleFromPath, isLocale, localeLabels } from "@i18n/locales";

const coverage = await getLocaleCoverage();
const current = getLocaleFromPath(Astro.url.pathname);

const options = i18nConfig.enabledLocales.filter(isLocale).map((code) => ({
	code,
	label: localeLabels[code],
	active: code === current,
	href: resolveAlternatePath(Astro.url.pathname, code, coverage),
}));
---

<div class="relative z-50 hidden md:block">
	<button
		aria-label="Language"
		aria-haspopup="menu"
		aria-expanded="false"
		aria-controls="language-panel"
		class="relative btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90 theme-switch-btn"
		id="language-switch"
		data-current-locale={current}
	>
		<Icon name="material-symbols:translate" class="text-[1.25rem]" />
	</button>

	<div
		id="language-panel"
		role="menu"
		class="absolute transition float-panel-closed top-11 -right-2 pt-5"
	>
		<div class="card-base float-panel p-2">
			{
				options.map((option) => (
					<a
						role="menuitem"
						href={option.href}
						hreflang={option.code}
						lang={option.code}
						data-no-swup
						data-target-locale={option.code}
						data-active={option.active}
						aria-current={option.active ? "true" : undefined}
						class:list={[
							"flex transition whitespace-nowrap items-center !justify-start w-full btn-plain rounded-lg h-9 px-3 font-medium active:scale-95 theme-switch-btn mb-0.5 last:mb-0",
							{ "scale-animation": !option.active },
						]}
					>
						<Icon
							name={
								option.active
									? "material-symbols:check"
									: "material-symbols:translate"
							}
							class="text-[1.25rem] mr-3"
						/>
						{option.label}
					</a>
				))
			}
		</div>
	</div>
</div>

<script type="application/json" id="locale-coverage" set:html={JSON.stringify(coverage)} />

<script>
	import { resolveAlternatePath } from "../../i18n/locale-paths";
	import { rememberLocale } from "../../scripts/locale-preference";
	import { panelManager } from "../../utils/panel-manager.js";

	const button = document.getElementById("language-switch");
	const panel = document.getElementById("language-panel");
	const data = document.getElementById("locale-coverage");

	if (button && panel && data) {
		const coverage = JSON.parse(data.textContent || "{}");
		// 收窄成非空，闭包里 TS 不会保留上面的判断
		const panelEl: HTMLElement = panel;

		button.addEventListener("click", async () => {
			const opened = await panelManager.togglePanel("language-panel");
			button.setAttribute("aria-expanded", String(opened));
		});

		// 导航栏在 swup 容器之外，客户端换页（含浏览器后退）不会重建它，
		// 于是面板上的"当前语言"标记和 href 都会过期 —— 用户按面板提示点
		// "另一种语言"，实际点到的可能是自己当前语言，看起来就是"点了没反应，
		// 再点一次才行"。所以每次打开面板都按真实地址校正一次。
		function currentLocaleFromPath() {
			const pathname = location.pathname;
			for (const [code, prefix] of Object.entries(coverage.prefixes)) {
				if (prefix && (pathname === prefix || pathname.startsWith(`${prefix}/`))) {
					return code;
				}
			}
			return Object.keys(coverage.prefixes)[0];
		}

		function syncPanel() {
			const current = currentLocaleFromPath();
			if (coverage.htmlLang?.[current]) {
				document.documentElement.lang = coverage.htmlLang[current];
			}
			for (const link of panelEl.querySelectorAll<HTMLAnchorElement>("a[data-target-locale]")) {
				const code = link.dataset.targetLocale;
				if (!code) continue;
				const isCurrent = code === current;
				if (link.dataset.active !== String(isCurrent)) {
					link.dataset.active = String(isCurrent);
					if (isCurrent) link.setAttribute("aria-current", "true");
					else link.removeAttribute("aria-current");
				}
				const target = resolveAlternatePath(location.pathname, code, coverage);
				if (link.getAttribute("href") !== target) link.href = target;
			}
		}

		// 手机端菜单里的语言选项同样要按真实地址校正
		function syncAll() {
			syncPanel();
			for (const block of document.querySelectorAll<HTMLElement>("[data-language-options]")) {
				for (const link of block.querySelectorAll<HTMLAnchorElement>("a[data-target-locale]")) {
					const code = link.dataset.targetLocale;
					if (!code) continue;
					const isCurrent = code === currentLocaleFromPath();
					if (link.dataset.active !== String(isCurrent)) {
						link.dataset.active = String(isCurrent);
						if (isCurrent) link.setAttribute("aria-current", "true");
						else link.removeAttribute("aria-current");
					}
					const target = resolveAlternatePath(location.pathname, code, coverage);
					if (link.getAttribute("href") !== target) link.href = target;
				}
			}
		}

		// 打开前校正，保证面板显示的就是当前状态
		button.addEventListener("click", syncAll);

		// swup 客户端换页后同样校正（换页不重建导航栏）
		const swup = (window as { swup?: { hooks?: { on: (n: string, f: () => void) => void } } }).swup;
		swup?.hooks?.on("page:view", syncAll);

		for (const link of document.querySelectorAll<HTMLAnchorElement>("a[data-target-locale]")) {
			link.addEventListener("click", () => {
				const locale = link.dataset.targetLocale;
				if (locale) rememberLocale(locale);
				else link.href = resolveAlternatePath(location.pathname, "en", coverage);
			});
		}
		syncAll();
	}
</script>
