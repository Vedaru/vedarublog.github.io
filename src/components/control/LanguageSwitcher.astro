---
/**
 * 语言选择器 / Language selector.
 *
 * 与导航栏其它控件（壁纸、明暗、布局）保持一致的交互：一个图标按钮 +
 * float-panel 下拉面板，列出所有已启用语言，当前语言打勾。
 *
 * 选项在这里算好（需要 Astro.url 才能推出各语言的同页地址），
 * 面板本身由 LanguageSwitch.svelte 渲染。
 */
import { i18nConfig } from "../../config";
import { getLocaleFromPath, localeLabels, isLocale } from "@i18n/locales";
import { rememberLocale } from "../../scripts/locale-preference";
import LanguageSwitch from "@components/control/LanguageSwitch.svelte";
import { resolveAlternatePath } from "@utils/i18n-routes";

const current = getLocaleFromPath(Astro.url.pathname);
const currentPath = Astro.url.pathname;

// 目标地址在构建期核对过，不存在就退回目标语言首页（例如中文独占的文章）。
const options = await Promise.all(
	i18nConfig.enabledLocales.filter(isLocale).map(async (code) => ({
		code,
		label: localeLabels[code],
		active: code === current,
		href: await resolveAlternatePath(currentPath, code),
	})),
);
---

<LanguageSwitch client:visible locale={current} options={options} />
