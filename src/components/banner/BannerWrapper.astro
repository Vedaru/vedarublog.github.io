---
import { url } from "../../utils/url-utils";

type BannerResponsive = {
	w768: string;
	w1280: string;
	w2560: string;
	full: string;
} | null;

interface Props {
	mobileNonHomeBannerClass: string;
	desktopBannerResponsive: BannerResponsive;
	mobileBannerResponsive: BannerResponsive;
	bannerObjectPosition: string;
	placeholder?: string;
	/** data: URI for the banner, so the first paint has the real image. */
	inlineSrc?: string | null;
}

const {
	mobileNonHomeBannerClass,
	desktopBannerResponsive,
	mobileBannerResponsive,
	bannerObjectPosition,
	placeholder,
	inlineSrc,
}: Props = Astro.props;
---

<!-- Banner - 始终渲染，通过 JS 控制显示隐藏 -->
<div
    id="banner-wrapper"
    class={`absolute z-10 w-full overflow-hidden ${mobileNonHomeBannerClass}`}
    style={placeholder ? `background-image: url("${placeholder}"); background-size: cover; background-position: ${bannerObjectPosition};` : undefined}
>
    {desktopBannerResponsive && (
        <div id="banner" class="relative h-full w-full">
            <img
                alt="Banner image of the blog"
                class="object-cover w-full h-full"
                src={inlineSrc ?? url(desktopBannerResponsive.full)}
                srcset={inlineSrc ? undefined : `${url((mobileBannerResponsive ?? desktopBannerResponsive).w768)} 768w, ${url(desktopBannerResponsive.w1280)} 1280w, ${url(desktopBannerResponsive.full)} 1920w, ${url(desktopBannerResponsive.w2560)} 2560w`}
                sizes={inlineSrc ? undefined : "100vw"}
                width={1920}
                height={1097}
                style={`object-position: ${bannerObjectPosition}`}
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />
        </div>
    )}
</div>
