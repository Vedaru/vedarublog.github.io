---
import { url } from "../../utils/url-utils";
import { BANNER_HEIGHT_EXTEND } from "../../constants";

type BannerResponsive = {
	w768: string;
	w1280: string;
	w2560: string;
	full: string;
} | null;

interface Props {
	mobileNonHomeBannerClass: string;
	desktopBannerResponsive: BannerResponsive;
	bannerObjectPosition: string;
}

const {
	mobileNonHomeBannerClass,
	desktopBannerResponsive,
	bannerObjectPosition,
}: Props = Astro.props;
---

<!-- Banner - 始终渲染，通过 JS 控制显示隐藏 -->
<div
    id="banner-wrapper"
    class={`absolute z-10 w-full transition duration-700 overflow-hidden ${mobileNonHomeBannerClass}`}
    style={`top: -${BANNER_HEIGHT_EXTEND}vh`}
>
    {desktopBannerResponsive && (
        <div id="banner" class="object-cover h-full transition duration-700 opacity-0 scale-105 overflow-hidden relative">
            <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
            <img
                alt="Banner image of the blog"
                class="w-full h-full object-cover"
                src={url(desktopBannerResponsive.full)}
                width={1920}
                height={1097}
                style={`object-position: ${bannerObjectPosition}`}
                loading="lazy"
                decoding="async"
            />
        </div>
    )}
</div>
