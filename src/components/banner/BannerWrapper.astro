---
import { siteConfig } from "../../config";
import { url } from "../../utils/url-utils";

type BannerResponsive = {
	w768: string;
	w1280: string;
	full: string;
} | null;

interface Props {
	mobileNonHomeBannerClass: string;
	desktopBannerResponsive: BannerResponsive;
	mobileBannerResponsive: BannerResponsive;
	bannerObjectPosition: string;
}

const {
	mobileNonHomeBannerClass,
	desktopBannerResponsive,
	mobileBannerResponsive,
	bannerObjectPosition,
}: Props = Astro.props;
---

<!-- Banner - 始终渲染，通过 JS 控制显示隐藏 -->
<div id="banner-wrapper" class={`absolute z-10 w-full transition-[transform,opacity] duration-700 ${mobileNonHomeBannerClass}`}>

    <!-- Banner 单图 -->
    <div id="banner-single-container" class="relative h-full w-full min-h-[inherit]">
        {desktopBannerResponsive && (
            <div class="absolute inset-0">
                <div class="banner-breathe-wrap h-full w-full overflow-hidden">
                    <picture>
                        <source
                            media="(max-width: 767px)"
                            srcset={`${url((mobileBannerResponsive ?? desktopBannerResponsive).w768)} 768w`}
                        />
                        <source
                            media="(min-width: 768px)"
                            srcset={`${url(desktopBannerResponsive.w1280)} 1280w, ${url(desktopBannerResponsive.full)} 1920w`}
                            sizes="100vw"
                        />
                        <img
                            id="banner"
                            alt="Banner image of the blog"
                            class="object-cover w-full h-full transition-transform duration-700"
                            src={url(desktopBannerResponsive.full)}
                            width={1920}
                            height={1097}
                            style={`object-position: ${bannerObjectPosition}`}
                            loading="eager"
                            fetchpriority="high"
                            decoding="async"
                        />
                    </picture>
                </div>
            </div>
        )}
    </div>
</div>
