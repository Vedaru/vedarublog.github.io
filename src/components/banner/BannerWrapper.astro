---
import { url } from "../../utils/url-utils";

type BannerResponsive = {
	w768: string;
	w1280: string;
	w2560: string;
	full: string;
} | null;

interface Props {
	desktopBannerResponsive: BannerResponsive;
	mobileBannerResponsive: BannerResponsive;
	bannerObjectPosition: string;
}

const {
	desktopBannerResponsive,
	mobileBannerResponsive,
	bannerObjectPosition,
}: Props = Astro.props;
---

<!-- Banner - Fuwari's persistent, composited banner subtree -->
<div
    id="banner-wrapper"
    class="absolute z-10 w-full transition duration-700 overflow-hidden"
>
    {desktopBannerResponsive && (
        <div id="banner" class="object-cover h-full transition duration-700 opacity-0 scale-105 overflow-hidden relative">
            <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
            <img
                alt="Banner image of the blog"
                class="w-full h-full object-cover"
                src={url(desktopBannerResponsive.full)}
                srcset={`${url((mobileBannerResponsive ?? desktopBannerResponsive).w768)} 768w, ${url(desktopBannerResponsive.w1280)} 1280w, ${url(desktopBannerResponsive.full)} 1920w, ${url(desktopBannerResponsive.w2560)} 2560w`}
                sizes="100vw"
                width={1920}
                height={1097}
                style={`object-position: ${bannerObjectPosition}`}
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />
        </div>
    )}
</div>
