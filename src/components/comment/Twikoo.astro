---
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import "../../styles/twikoo.css";
import { commentConfig } from "@/config";
import { getLocaleFromPath } from "@/i18n/locales";

interface Props {
	path: string;
}

const twikooOptions = commentConfig.twikoo;
const locale = getLocaleFromPath(Astro.url.pathname);

/**
 * Twikoo 只认 zh-CN 与 en-US（脚本里的 LANGS = { ZH: "zh-CN", EN: "en-US" }），
 * 传 "en" 会被忽略并退回中文 —— 之前英文页的评论区就是这么变成中文的。
 * 页面语言优先，配置里的 lang 只在遇到未知语言时兜底。
 */
const TWIKOO_LANG: Record<string, string> = { zh: "zh-CN", en: "en-US" };
const twikooLang = TWIKOO_LANG[locale] ?? twikooOptions?.lang ?? "zh-CN";
---

<div
	id="tcomment"
	class="twikoo-root"
	data-twikoo-env={twikooOptions?.envId}
	data-twikoo-lang={twikooLang}
	data-twikoo-path={Astro.props.path}
>
	<div class="twikoo-loading" aria-busy="true">{i18n(I18nKey.commentLoading, Astro.currentLocale)}</div>
</div>
