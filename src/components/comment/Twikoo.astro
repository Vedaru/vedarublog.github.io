---
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import "../../styles/twikoo.css";
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const twikooOptions = commentConfig.twikoo;
---

<div
	id="tcomment"
	class="twikoo-root"
	data-twikoo-env={twikooOptions?.envId}
	data-twikoo-lang={twikooOptions?.lang ?? "zh-CN"}
	data-twikoo-path={Astro.props.path}
>
	<div class="twikoo-loading" aria-busy="true">{i18n(I18nKey.commentLoading, Astro.currentLocale)}</div>
</div>
