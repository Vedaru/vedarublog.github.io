---
import type { CollectionEntry } from "astro:content";
import { commentConfig } from "@/config";
import { getPostUrl } from "@/utils/url-utils";
import { defaultLocale, stripLocalePrefix } from "@/i18n/locales";
import Twikoo from "./Twikoo.astro";

interface Props {
	post: CollectionEntry<"posts">;
}

const { id, data: _data } = Astro.props.post;

// 评论按 path 存储，所以这个键必须稳定：文章 URL 从 /posts/x/ 变成
// /zh/posts/x/ 之后，键一变所有历史评论就"消失"了。默认语言用去掉前缀的
// 路径（等于迁移前的键），其它语言用带前缀的路径。
const localizedPath = getPostUrl({ id, data: _data });
const path = (
	Astro.currentLocale === defaultLocale
		? stripLocalePrefix(localizedPath)
		: localizedPath
).replace(/\/$/, "");
// const url = `${Astro.site?.href}${path}`;

let commentService = "";
if (commentConfig?.enable && commentConfig?.twikoo) {
	commentService = "twikoo";
}
---
{commentConfig?.enable && (
  <div class="card-base comment-card p-6 mb-4">
    {commentService === 'twikoo' && <Twikoo path={path} />}
    {commentService === '' && null}
  </div>
)}
