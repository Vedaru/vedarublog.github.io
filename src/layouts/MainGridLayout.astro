---
import BackToTop from "@components/control/BackToTop.astro";
import FloatingTOC from "@components/control/FloatingTOC.astro";
import Footer from "@components/Footer.astro";
import RightSideBar from "@components/layout/RightSideBar.astro";
import Navbar from "@components/nav/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import BannerWrapper from "@components/banner/BannerWrapper.astro";
import type { MarkdownHeading } from "astro";
import TOC from "../components/widget/TOC.astro";
import {
	siteConfig,
} from "../config";
import { widgetManager } from "../utils/widget-manager";
import {
	getBannerImages,
	getBannerResponsive,
	toBannerSrcList,
} from "../utils/banner-utils";
import { getBannerPlaceholder } from "../utils/banner-placeholder";
import { isMainHomePage } from "../utils/route-utils";
import { url } from "../utils/url-utils";
import Layout from "./Layout.astro";

// TOC模式配置
const tocMode = siteConfig.toc.mode || "float";
const isFloatTOC = tocMode === "float";
const isSidebarTOC = tocMode === "sidebar";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	/** 该页在两种语言下都存在时设为 true，透传给 Layout 输出 hreflang。 */
	dualLocale?: boolean;
}

const bannerImages = getBannerImages();
const desktopBannerList = toBannerSrcList(
	bannerImages.desktop as string | string[] | undefined,
);
const mobileBannerList = toBannerSrcList(
	bannerImages.mobile as string | string[] | undefined,
);
const singleDesktopBanner = desktopBannerList[0];
const singleMobileBanner = mobileBannerList[0];

const desktopBannerResponsive = getBannerResponsive(singleDesktopBanner);
const mobileBannerResponsive =
	getBannerResponsive(singleMobileBanner) ?? desktopBannerResponsive;
const bannerPlaceholder = await getBannerPlaceholder(singleDesktopBanner);

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	dualLocale,
} = Astro.props;
// 检查是否为首页
const isHomePage = isMainHomePage(Astro.url.pathname);
const shouldPreloadDesktopBanner = Boolean(desktopBannerResponsive);
const shouldPreloadMobileBanner = isHomePage && Boolean(mobileBannerResponsive);
const bannerObjectPosition = siteConfig.banner.position || "center";
const mobileBannerObjectPosition =
	siteConfig.banner.mobilePosition || "left center";
// 手机端非首页不显示 banner（只在 content:replace 之后切换，避免旧页面跳动）
const mobileNonHomeBannerClass = !isHomePage ? "mobile-hide-banner" : "";

// 检查左侧边栏是否有组件
const hasLeftSidebarComponents =
	widgetManager.getComponentsByPosition("top", "left", "desktop").length > 0 ||
	widgetManager.getComponentsByPosition("sticky", "left", "desktop").length > 0;

// 检查右侧边栏是否有组件
const hasRightSidebarComponents =
	widgetManager.getComponentsByPosition("top", "right", "desktop").length > 0 ||
	widgetManager.getComponentsByPosition("sticky", "right", "desktop").length > 0;

// 检查手机端 drawer 是否有组件
const hasMobileDrawerComponents =
	widgetManager.getComponentsByPosition("top", "drawer", "mobile").length > 0 ||
	widgetManager.getComponentsByPosition("sticky", "drawer", "mobile").length > 0;

// 平板端是否有组件（考虑自动移动逻辑）
const hasTabletLeftSidebarComponents =
	widgetManager.getComponentsByPosition("top", "left", "tablet").length > 0 ||
	widgetManager.getComponentsByPosition("sticky", "left", "tablet").length > 0;

// 栅格布局只由 #main-grid 上的 data-* 属性表达，列宽与各区域定位统一在
// layout-stable.css 的「Main grid」一节定义。以前同一套布局在这个文件里拼
// class 字符串、又在 <style> 里用 !important 覆盖，两处会互相打架。
const mobileShowSidebar = hasMobileDrawerComponents;
const tabletShowSidebar = hasTabletLeftSidebarComponents;
const desktopSides =
	hasLeftSidebarComponents && hasRightSidebarComponents
		? "both"
		: hasLeftSidebarComponents
			? "left"
			: hasRightSidebarComponents
				? "right"
				: "none";

const defaultPostListLayout = siteConfig.postListLayout?.defaultMode || "list";
const showSidebarTOC =
	siteConfig.toc.enable && isSidebarTOC && headings.length > 0;

---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} dualLocale={dualLocale}>

{shouldPreloadDesktopBanner && desktopBannerResponsive && (
	<link
		slot="head"
		rel="preload"
		as="image"
		imagesrcset={`${url(desktopBannerResponsive.w1280)} 1280w, ${url(desktopBannerResponsive.full)} 1920w, ${url(desktopBannerResponsive.w2560)} 2560w`}
		imagesizes="100vw"
		fetchpriority="high"
		media="(min-width: 768px)"
	/>
)}
<style
	slot="head"
	is:inline
	set:html={`@media (max-width:767px){#banner img{object-position:${mobileBannerObjectPosition}!important;-o-object-position:${mobileBannerObjectPosition}!important}}`}
></style>
{shouldPreloadMobileBanner && mobileBannerResponsive && (
	<link
		slot="head"
		rel="preload"
		as="image"
		imagesrcset={`${url(mobileBannerResponsive.w768)} 768w`}
		imagesizes="100vw"
		fetchpriority="high"
		media="(max-width: 767px)"
	/>
)}

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-[opacity,transform] duration-300">
        <Navbar></Navbar>
    </div>
</div>

<BannerWrapper
	mobileNonHomeBannerClass={mobileNonHomeBannerClass}
	desktopBannerResponsive={desktopBannerResponsive}
	mobileBannerResponsive={mobileBannerResponsive}
	bannerObjectPosition={bannerObjectPosition}
	placeholder={bannerPlaceholder}
/>

<!-- Main content -->
<div
	class:list={[
		"main-panel absolute w-full z-30 pointer-events-none",
		mobileNonHomeBannerClass ? "mobile-main-no-banner" : "",
	]}
>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto min-w-0 w-full">
        <div id="main-grid" class="w-full max-w-[var(--page-width)] min-w-0 left-0 right-0 mx-auto gap-4 px-2 md:px-4"
             data-layout-mode={defaultPostListLayout}
             data-sides={desktopSides}
             data-mobile={mobileShowSidebar ? "true" : "false"}
        >
            {/* 侧边栏和主内容区域容器 */}
            <div class="contents">
                {(mobileShowSidebar || tabletShowSidebar || hasLeftSidebarComponents || hasRightSidebarComponents) && (
                    <SideBar class="onload-animation" headings={headings}></SideBar>
                )}
                
                {hasRightSidebarComponents && (
                    <div class="right-sidebar-container onload-animation">
                        <RightSideBar headings={headings}></RightSideBar>
                    </div>
                )}
            </div>

            <main id="swup-container" class="w-full transition-swup-fade min-w-0 overflow-hidden">
                <div class="sr-only" data-swup-a11y-title>{title || siteConfig.title}</div>
                <div id="content-wrapper" class="onload-animation">
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer col-span-full onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <div class="footer col-span-full onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
        {siteConfig.toc.enable && isFloatTOC && <FloatingTOC />}
    </div>
</div>

<!-- 侧边栏 TOC。`#toc` 是 Swup 容器，永远位于同一位置，
     换页时由 Swup 整体替换，自定义元素随之重新升级。 -->
<div class:list={[
    "absolute w-full z-0 hidden 2xl:block",
    !isSidebarTOC && "!hidden",
]}>
    <div class="relative max-w-[var(--page-width)] mx-auto">
        <div id="toc-wrapper" class:list={["hidden lg:block transition absolute top-0 w-[var(--toc-width)] items-center",
            "-right-[var(--toc-width)]",
            {"toc-hide": siteConfig.wallpaperMode.defaultMode === "banner"}]}
        >
            <div id="toc-inner-wrapper" class="fixed top-14 w-[var(--toc-width)] max-h-[calc(100vh_-_10rem)] overflow-y-auto hide-scrollbar">
                <div id="toc" class="w-full transition-swup-fade">
                    {showSidebarTOC && <TOC headings={headings}></TOC>}
                </div>
            </div>
        </div>
    </div>
</div>
</Layout>

<style>
/* TOC 垂直对齐优化 */
body.no-banner-mode #toc-inner-wrapper {
    top: 5.5rem !important;
    max-height: calc(100vh - 8rem) !important;
}

/* 移动端banner性能优化 */
@media (max-width: 1279px) {
    .banner-container {
        /* 启用硬件加速 */
        transform: translateZ(0);
        -webkit-transform: translateZ(0);
        
        /* 优化渲染性能 */
        contain: layout style paint;
        
        /* 减少重绘 */
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    /* 移动端图片优化 */
    .banner-container img {
        /* 图片渲染优化 */
        image-rendering: -webkit-optimize-contrast;
        image-rendering: crisp-edges;
        
        /* 防止图片拖拽 */
        -webkit-user-drag: none;
        -khtml-user-drag: none;
        -moz-user-drag: none;
        -o-user-drag: none;
        user-drag: none;
        
        /* 触摸优化 */
        pointer-events: none;
    }
}

/* 移动端横屏优化 — 布局高度见 layout-stable.css */
@media (max-width: 1279px) and (orientation: landscape) {
    .banner-container {
        height: 60vh;
        min-height: 300px;
    }

}
</style>
