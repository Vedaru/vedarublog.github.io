---
/**
 * 英文文章页（/en/posts/<slug>/）。
 *
 * 与中文文章页共用同一份正文组件（components/pages/PostDetailPage.astro），
 * 语言由 /en/ 前缀决定。这里只提供英文文章集合与路由参数。
 */
import PostDetailPage from "@components/pages/PostDetailPage.astro";
import { getSortedPosts, postSlug } from "@utils/content-utils";
import { hasCustomPermalink, initPostIdMap } from "@utils/permalink-utils";
import { permalinkConfig } from "@/config";

export async function getStaticPaths() {
	const posts = await getSortedPosts("en");

	initPostIdMap(posts, "en");

	// 与中文路由一致：带 permalink 的文章只由 /en/[permalink].astro 生成，
	// 否则同一篇文章会有 /en/posts/<slug>/ 和 /en/<permalink>/ 两个地址。
	return posts
		.filter((entry) => !hasCustomPermalink(entry) && !permalinkConfig.enable)
		.map((entry) => ({
			params: { slug: postSlug(entry) },
			props: { entry },
		}));
}

const { entry } = Astro.props;
---

<PostDetailPage entry={entry} />
