---
import AnimePanel from "../components/features/anime/AnimePanel.svelte";
import type {
	AnimeFilterTab,
	AnimeStatusMeta,
} from "../components/features/anime/types";
import { siteConfig } from "../config";
import {
	ANIME_MODE,
	BANGUMI_USER_ID,
	INITIAL_DISPLAY_COUNT,
	loadAnimeList,
} from "../data/anime-list";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
import "../styles/anime.css";

if (!siteConfig.featurePages.anime) {
	return Astro.redirect("/404/");
}

// 数据加载集中在 src/data/anime-list.ts（local 列表 / 构建期 bangumi-data.json）。
const animeList = loadAnimeList();

// 状态徽章的文案/配色/图标在本页解析（i18n 只能在构建期拿到），
// 之后作为 props 传给岛屿，客户端无需再重复这套映射。
const statusMeta: Record<string, AnimeStatusMeta> = {
	watching: {
		text: i18n(I18nKey.animeStatusWatching),
		class: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300",
		icon: "▶",
	},
	completed: {
		text: i18n(I18nKey.animeStatusCompleted),
		class: "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300",
		icon: "✓",
	},
	planned: {
		text: i18n(I18nKey.animeStatusPlanned),
		class: "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300",
		icon: "❤",
	},
	onhold: {
		text: i18n(I18nKey.animeStatusOnHold),
		class: "bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300",
		icon: "⏸",
	},
	dropped: {
		text: i18n(I18nKey.animeStatusDropped),
		class: "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300",
		icon: "✗",
	},
	// 未知状态的兜底：文案由岛屿换成原始 status 值。
	default: {
		text: "",
		class: "bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300",
		icon: "?",
	},
};

const filterTabs: AnimeFilterTab[] = [
	{ value: "all", label: i18n(I18nKey.animeFilterAll) },
	{ value: "watching", label: i18n(I18nKey.animeStatusWatching) },
	{ value: "planned", label: i18n(I18nKey.animeStatusPlanned) },
	{ value: "completed", label: i18n(I18nKey.animeStatusCompleted) },
];

if (ANIME_MODE === "bangumi") {
	filterTabs.push(
		{ value: "onhold", label: i18n(I18nKey.animeStatusOnHold) },
		{ value: "dropped", label: i18n(I18nKey.animeStatusDropped) },
	);
}

const animeLabels = {
	year: i18n(I18nKey.animeYear),
	studio: i18n(I18nKey.animeStudio),
};

// 封面为 public 下的根路径，需要补上部署基路径；远程 URL 原样保留。
const resolveCover = (src: string) => (src.startsWith("/") ? url(src) : src);

// 全量解析后一次交给岛屿：首屏只渲染前 INITIAL_DISPLAY_COUNT 条，
// 其余条目随 props 一起下发，滚动到哨兵时同步揭示，无需再发请求。
const resolvedAnimeList = animeList.map((anime) => ({
	...anime,
	cover: resolveCover(anime.cover),
}));
---

<MainGridLayout
	title={i18n(I18nKey.anime)}
	description={i18n(I18nKey.animeSubtitle)}
>
	<!-- 让列表/网格布局切换时右侧边栏同步隐藏（原 anime-page.js 里的手工处理） -->
	<script>
		import('../scripts/right-sidebar-layout.js');
	</script>
	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base anime-card-base z-10 px-9 py-6 relative w-full">
			<div class="mb-6">
				<h1
					class="text-4xl font-bold text-black/90 dark:text-white/90 mb-2 relative
                    before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
				>
					{i18n(I18nKey.animeTitle)}
				</h1>
				<p class="text-black/75 dark:text-white/75">
					{i18n(I18nKey.animeSubtitle)}
				</p>
			</div>

			{
				ANIME_MODE !== "local" && BANGUMI_USER_ID === "your-user-id" ? (
					<div class="text-center py-12">
						<div class="text-5xl mb-4">😢</div>
						<h3 class="text-xl font-medium text-black/80 dark:text-white/80 mb-2">
							{i18n(I18nKey.animeEmpty)}
						</h3>
						<p class="text-black/60 dark:text-white/60">
							Please set your Bangumi userId in the src/config.ts
							file
						</p>
					</div>
				) : resolvedAnimeList.length > 0 ? (
					<AnimePanel
						items={resolvedAnimeList}
						initialCount={INITIAL_DISPLAY_COUNT}
						tabs={filterTabs}
						{statusMeta}
						labels={animeLabels}
						client:load
					/>
				) : (
					<div class="text-center py-12">
						<div class="text-5xl mb-4">😢</div>
						<h3 class="text-xl font-medium text-black/80 dark:text-white/80 mb-2">
							{i18n(I18nKey.animeEmpty)}
						</h3>
						<p class="text-black/60 dark:text-white/60">
							{ANIME_MODE === "local"
								? i18n(I18nKey.animeEmptyLocal)
								: i18n(I18nKey.animeEmptyBangumi)}
						</p>
					</div>
				)
			}
		</div>
	</div>
</MainGridLayout>
