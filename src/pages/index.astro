---
/**
 * 根路径的语言入口（静态兜底）。
 *
 * 线上由 Cloudflare Pages Function（functions/index.ts）在边缘直接 302，
 * 访客看不到任何中间页面。这里只是没有边缘逻辑时的退路：同样只做跳转，
 * 不显示任何文字，避免"先看到一个跳转页"。
 */
import { locales, localizePath } from "@i18n/locales";
import { LOCALE_COOKIE } from "../scripts/locale-preference";

const entries = locales.map((locale) => ({
	locale,
	href: localizePath("/", locale),
}));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>vedaru.cn</title>
		{
			entries.map((entry) => (
				<link rel="alternate" hreflang={entry.locale} href={entry.href} />
			))
		}
		<script is:inline define:vars={{ LOCALE_COOKIE, entries }}>
			(function () {
				var available = {};
				for (var i = 0; i < entries.length; i++) {
					available[entries[i].locale] = entries[i].href;
				}

				var saved = null;
				var match = document.cookie.match(
					new RegExp("(?:^|;\\s*)" + LOCALE_COOKIE + "=([^;]+)"),
				);
				if (match) saved = decodeURIComponent(match[1]);

				var target = available[saved] ? saved : null;
				if (!target) {
					var preferred = navigator.languages || [navigator.language || ""];
					for (var j = 0; j < preferred.length && !target; j++) {
						var code = String(preferred[j]).toLowerCase();
						if (code.indexOf("zh") === 0) target = "zh";
						else if (code.indexOf("en") === 0) target = "en";
					}
				}

				location.replace(available[target] || available.zh);
			})();
		</script>
	</head>
	<body style="margin:0;background:var(--page-bg,#fff)"></body>
</html>
