---
import Icon from "../components/misc/Icon.astro";
import IconifyLoader from "../components/misc/IconifyLoader.astro";
import SkillCard from "../components/skills/SkillCard.astro";
import { siteConfig } from "../config";
import {
	categoryMeta,
	getActiveCategories,
	getSkillStats,
	skillsData,
} from "../data/skills";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

import MainGridLayout from "../layouts/MainGridLayout.astro";

// 检查技能页面是否启用
if (!siteConfig.featurePages.skills) {
	return Astro.redirect("/404/");
}

const stats = getSkillStats();

// 分类顺序由数据文件决定，只保留实际有技能的分类
const categories = getActiveCategories();

// 分类 -> 筛选标签图标
const categoryIcons: Record<string, string> = {
	languages: "material-symbols:code",
	systems: "material-symbols:terminal",
	web: "material-symbols:language",
	infra: "material-symbols:cloud",
	tools: "material-symbols:build",
	other: "material-symbols:widgets",
};

// 筛选标签：全部 + 每个分类
const filterTabs = [
	{
		value: "all",
		label: i18n(I18nKey.friendsFilterAll),
		icon: "material-symbols:apps",
		count: skillsData.length,
	},
	...categories.map((category) => ({
		value: category,
		label: i18n(categoryMeta[category].i18nKey),
		icon: categoryIcons[category] ?? "material-symbols:widgets",
		count: stats.byCategory[category],
	})),
];

const title = i18n(I18nKey.skills);
const subtitle = i18n(I18nKey.skillsSubtitle);

// 收集所有技能图标用于预加载
const allIcons = skillsData.map((skill) => skill.icon).filter(Boolean);
---

<MainGridLayout title={title} description={subtitle}>
  <!-- 设置页面类型属性 -->
  <script is:inline>
    document.documentElement.setAttribute('data-page-type', 'skills');
  </script>

  <!-- 引入右侧边栏布局管理器 -->
  <script>
    import('../scripts/right-sidebar-layout.js');
  </script>
  <!-- 图标加载器，预加载所有技能图标 -->
  <IconifyLoader preloadIcons={allIcons} />

  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="flex flex-col items-start justify-center mb-8">
        <h1 class="text-4xl font-bold text-black/90 dark:text-white/90 mb-2 relative
                  before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                  before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4">
          {i18n(I18nKey.skills)}
        </h1>
        <p class="text-lg text-black/60 dark:text-white/60">
          {i18n(I18nKey.skillsSubtitle)}
        </p>
      </div>

      <!-- 分类筛选标签 -->
      <div class="flex flex-wrap justify-center gap-2 mb-8">
        {filterTabs.map((tab) => (
          <button
            type="button"
            class:list={[
              "skill-filter-tab inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium border border-black/10 dark:border-white/20 text-black/70 dark:text-white/70 hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-200",
              tab.value === "all" && "is-active",
            ]}
            data-category={tab.value}
            aria-pressed={tab.value === "all" ? "true" : "false"}
          >
            <Icon icon={tab.icon} class="text-base" fallback={tab.label.charAt(0)} />
            <span>{tab.label}</span>
            <span class="skill-filter-count">{tab.count}</span>
          </button>
        ))}
      </div>

      <!-- 技能网格 -->
      <div class="skills-container" style="container-type: inline-size;">
        <div id="skills-grid" class="grid gap-6 items-start">
          {skillsData.map((skill) => (
            <SkillCard skill={skill} />
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- 分类筛选逻辑（全局脚本，Swup 导航后仍生效） -->
  <script is:inline src="/js/skills-page-handler.js"></script>
</MainGridLayout>

<style>
  /* 移动端：单列 */
  #skills-grid {
    grid-template-columns: 1fr;
    transition: grid-template-columns 0.3s ease;
  }

  /* 内容区域宽度 >= 640px：2列 */
  @container (min-width: 40rem) {
    #skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* 内容区域宽度 >= 900px：3列 */
  @container (min-width: 56.25rem) {
    #skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skill-filter-tab.is-active {
    background-color: var(--primary);
    border-color: transparent;
    color: var(--btn-content);
  }

  .skill-filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.3rem;
    border-radius: 9999px;
    font-size: 0.7rem;
    line-height: 1;
    background-color: rgb(0 0 0 / 0.08);
  }

  .skill-filter-tab.is-active .skill-filter-count {
    background-color: rgb(255 255 255 / 0.25);
  }

  :global(.dark) .skill-filter-tab.is-active .skill-filter-count {
    background-color: rgb(255 255 255 / 0.25);
  }

  :global(.dark) .skill-filter-count {
    background-color: rgb(255 255 255 / 0.12);
  }
</style>
