---
/**
 * 中文文章页路由（/zh/posts/<slug>/）。正文见 components/pages/PostDetailPage.astro。
 */
import type { CollectionEntry } from "astro:content";
import PostDetailPage from "@components/pages/PostDetailPage.astro";
import { getSortedPosts, postSlug } from "@utils/content-utils";
import { hasCustomPermalink, initPostIdMap } from "@utils/permalink-utils";
import { permalinkConfig } from "../../../config";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();

	// 初始化文章 ID 映射（用于 %post_id% 占位符）
	initPostIdMap(blogEntries);

	const paths: {
		params: { slug: string };
		props: { entry: CollectionEntry<"posts"> };
	}[] = [];

	for (const entry of blogEntries) {
		// 用 postSlug 去掉 .zh 后缀，否则路由会变成 /zh/posts/x.zh/
		const defaultSlug = postSlug(entry);

		paths.push({ params: { slug: defaultSlug }, props: { entry } });

		// 仅在未启用 permalink（自定义或全局）时，才为 alias 创建路径
		if (!hasCustomPermalink(entry) && !permalinkConfig.enable && entry.data.alias) {
			let alias = entry.data.alias.replace(/^\/+/, "").replace(/\/+$/, "");
			if (alias.startsWith("posts/")) alias = alias.replace(/^posts\//, "");
			paths.push({ params: { slug: alias }, props: { entry } });
		}
	}

	return paths;
}

const { entry } = Astro.props;
---

<PostDetailPage entry={entry} />
