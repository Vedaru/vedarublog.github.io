---
/**
 * 相册详情路由壳（/albums/<id>/）。
 * 结构见 @components/pages/albums/AlbumDetailPage.astro。
 */
import AlbumDetailPage from "@components/pages/albums/AlbumDetailPage.astro";
import type { AlbumGroup } from "@/types/album";
import { scanAlbums } from "@/utils/album-scanner";

export async function getStaticPaths() {
	const albumsData = await scanAlbums();
	return albumsData.map((album: AlbumGroup) => ({
		params: { id: album.id },
		props: { album },
	}));
}

const { album } = Astro.props;
---

<AlbumDetailPage album={album} />
