---
/**
 * 处理带自定义 permalink 的文章。
 *
 * 页面渲染完全复用 PostDetailPage，避免与 /posts/<slug>/ 维护两套几乎相同
 * 的文章模板。这里只负责把 permalink 映射成路由参数。
 */
import type { CollectionEntry } from "astro:content";
import { defaultLocale } from "@i18n/locales";
import PostDetailPage from "@components/pages/PostDetailPage.astro";
import { getSortedPosts } from "@utils/content-utils";
import {
	generatePermalinkSlug,
	hasCustomPermalink,
	initPostIdMap,
} from "@utils/permalink-utils";
import { permalinkConfig } from "@/config";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts(defaultLocale);
	initPostIdMap(blogEntries);

	const paths: {
		params: { permalink: string };
		props: { entry: CollectionEntry<"posts"> };
	}[] = [];

	for (const entry of blogEntries) {
		let permalink: string | null = null;

		if (hasCustomPermalink(entry)) {
			permalink = entry.data
				.permalink!.replace(/^\/+/, "")
				.replace(/\/+$/, "");
		} else if (permalinkConfig.enable) {
			permalink = generatePermalinkSlug(entry);
		}

		if (permalink) {
			paths.push({
				params: { permalink },
				props: { entry },
			});
		}
	}

	return paths;
}

const { entry } = Astro.props;
---

<PostDetailPage entry={entry} />
